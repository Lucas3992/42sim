generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Language {
  EN
  FR
  NL
}

enum ConversationType {
  DIRECT
  ROOM
}

model User {
  id                  Int                  @id @default(autoincrement())
  email               String               @unique
  username            String               @unique
  password_hash       String?
  ft_id               Int?                 @unique
  ft_login            String?
  avatar_url          String?
  displayName         String?
  bio                 String?
  isOnline            Boolean              @default(false)
  lastSeenAt          DateTime?
  friendshipsAsA      Friendship[]         @relation("FriendshipA")
  friendshipsAsB      Friendship[]         @relation("FriendshipB")
  prefLang            Language             @default(EN)
  conversationsA      Conversation[]       @relation("ConversationUserA")
  conversationsB      Conversation[]       @relation("ConversationUserB")
  conversationMembers ConversationMember[]
  messages            Message[]
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

model Friendship {
  id          Int              @id @default(autoincrement())
  userAId     Int
  userBId     Int
  requestedBy Int
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?
  userA       User             @relation("FriendshipA", fields: [userAId], references: [id], onDelete: Cascade)
  userB       User             @relation("FriendshipB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userBId])
}

model Conversation {
  id      Int              @id @default(autoincrement())
  type    ConversationType
  slug    String?          @unique
  userAId Int?
  userBId Int?
  userA   User?            @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB   User?            @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)

  createdAt DateTime             @default(now())
  members   ConversationMember[]
  messages  Message[]

  @@unique([userAId, userBId])
}

model ConversationMember {
  conversationId Int
  userId         Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             Int    @id @default(autoincrement())
  conversationId Int
  senderId       Int
  content        String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([conversationId, createdAt])
  @@index([senderId])
}
