# Database
DATABASE_URL=postgresql://<db_user>:<db_password>@db:5432/<db_name>
POSTGRES_USER=<db_user>
POSTGRES_PASSWORD=<db_password>
POSTGRES_DB=<db_name>

# Auth
JWT_SECRET=<generate_with_openssl_rand_-hex_32>

# OAuth 42
FT_CLIENT_ID=<your_42_intra_client_id>
FT_CLIENT_SECRET=<your_42_intra_client_secret>
FT_REDIRECT_URI=https://localhost:3000/auth/42/callback